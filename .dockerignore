# The server image builds from the repository root (verily_kit/Dockerfile)
# and needs only these paths. Everything else, including the ignored .env and
# local build caches, stays out of the build context.
*
!monosecret.toml
!verily_kit/
verily_kit/target/
verily_kit/dist/
verily_kit/.env
verily_kit/.leptoskit/
verily_kit/android/.gradle/
verily_kit/android/build/
verily_kit/ios/build/
