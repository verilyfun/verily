# Copy to `.env` (ignored, mode 0600) for local development. Names only:
# never commit a value. Monosecret reads `.env` first, then the Development
# vault ("Verily"), so cloud secrets are optional on a machine with vault access.

# Bootstraps the 1Password route; read from this file, never passed on a CLI.
OP_SERVICE_ACCOUNT_TOKEN=

# Core runtime (LeptosKit + PostgreSQL/PostGIS).
DATABASE_URL=postgres://postgres@127.0.0.1:8191/verily
AUTH_ENCRYPTION_KEYS=
VERILY_BIND_ADDRESS=127.0.0.1
VERILY_PORT=8184

# Email sign-in (Resend) and optional Google OAuth.
VERILY_AUTH_EMAIL_FROM=
VERILY_RESEND_API_KEY=
VERILY_GOOGLE_CLIENT_ID=
VERILY_GOOGLE_CLIENT_SECRET=

# Evidence storage. Leave B2 values empty in development to store evidence on
# local disk; staging and production require private Backblaze B2.
VERILY_EVIDENCE_STORAGE_MODE=local
VERILY_LOCAL_EVIDENCE_DIR=
VERILY_B2_ENDPOINT=
VERILY_B2_REGION=
VERILY_B2_BUCKET=
VERILY_B2_KEY_ID=
VERILY_B2_APPLICATION_KEY=

# Device capture integrity and attestation.
VERILY_ANDROID_PACKAGE_NAME=fun.verily.app
VERILY_ANDROID_SIGNING_CERT_SHA256=
VERILY_GOOGLE_PLAY_INTEGRITY_SERVICE_ACCOUNT_JSON=
VERILY_APPLE_TEAM_ID=
VERILY_IOS_BUNDLE_ID=fun.verily.app
VERILY_APPLE_APP_ATTEST_ENV=production
VERILY_APPLE_DEVICECHECK_KEY_ID=
VERILY_APPLE_DEVICECHECK_PRIVATE_KEY=

# Proof verification & AI authoring.
# manual-review needs no secret. openrouter stays fail-closed in production
# until VERILY_OPENROUTER_PROMPT_INJECTION_GUARD=block,
# VERILY_OPENROUTER_PROMPT_INJECTION_GUARD_CONFIRMED=true, and
# VERILY_OPENROUTER_REQUIRE_ZDR=true are explicitly confirmed.
VERILY_MEDIA_VERIFIER_MODE=manual-review
VERILY_MEDIA_VERIFIER_URL=
VERILY_MEDIA_VERIFIER_TOKEN=
VERILY_OPENROUTER_API_KEY=
VERILY_OPENROUTER_URL=
VERILY_OPENROUTER_PRIMARY_MODEL=
VERILY_OPENROUTER_COUNCIL_MODELS=
VERILY_OPENROUTER_PROMPT_INJECTION_GUARD=block
VERILY_OPENROUTER_PROMPT_INJECTION_GUARD_CONFIRMED=false
VERILY_OPENROUTER_REQUIRE_ZDR=true

# Abuse risk pseudonymization.
VERILY_ABUSE_RISK_SALT=

# Reward escrow: disabled, local-development (simulation only), or solana.
VERILY_REWARD_ESCROW_MODE=disabled
VERILY_REWARD_REVIEW_THRESHOLD_ATOMS=
VERILY_REWARD_CLUSTER=devnet
VERILY_REWARD_SOLANA_RPC_URL=
VERILY_REWARD_ARBITER_ADDRESS=
VERILY_REWARD_FEE_PAYER_ADDRESS=
VERILY_REWARD_ARBITER_KEYPAIR=
VERILY_REWARD_FEE_PAYER_KEYPAIR=
# Production/staging Cloud KMS keys:
# VERILY_REWARD_ARBITER_KMS_KEY=projects/.../cryptoKeyVersions/1
# VERILY_REWARD_FEE_PAYER_KMS_KEY=projects/.../cryptoKeyVersions/1
# VERILY_REWARD_KMS_CREDENTIALS_FILE=
# VERILY_REWARD_KMS_CREDENTIALS_JSON=
# VERILY_REWARD_SOLANA_GENESIS_HASH=
# VERILY_REWARD_ESCROW_PROGRAM_ID=
# VERILY_REWARD_MAINNET_ENABLED=false

# Partner Verily Apps receipt signing (published in /.well-known/jwks.json).
VERILY_RECEIPT_SIGNING_KEY_ID=
VERILY_RECEIPT_SIGNING_PRIVATE_KEY=
