# Copy to `.env` (ignored, mode 0600) for local development. Names only:
# never commit a value. Monosecret reads `.env` first, then the Development
# vault, so every secret below is optional on a machine with vault access.
# Generated local secrets (Serverpod service secret, JWT key, peppers, abuse
# pseudonym secret) are written here by Monosecret on first run.

# Bootstraps the 1Password route; read from this file, never passed on a
# command line.
OP_SERVICE_ACCOUNT_TOKEN=

# Serverpod runtime. Loopback Postgres uses trust authentication locally.
SERVERPOD_DATABASE_PASSWORD=
SERVERPOD_SERVICE_SECRET=
SERVERPOD_PASSWORD_emailSecretHashPepper=
SERVERPOD_PASSWORD_jwtHmacSha512PrivateKey=
SERVERPOD_PASSWORD_jwtRefreshTokenHashPepper=
SERVERPOD_PASSWORD_googleClientSecret=

# Email sign-in: development-log prints codes to the server log.
VERILY_EMAIL_AUTH_MODE=development-log
VERILY_EMAIL_FROM=
VERILY_RESEND_API_KEY=

# Evidence storage. Leave the B2 values empty to store evidence in the local
# database (development and test only); staging and production require B2.
VERILY_EVIDENCE_STORAGE=
VERILY_EVIDENCE_B2_S3_ENDPOINT=
VERILY_EVIDENCE_B2_REGION=
VERILY_EVIDENCE_B2_BUCKET_NAME=
VERILY_EVIDENCE_B2_KEY_ID=
VERILY_EVIDENCE_B2_APPLICATION_KEY=

# Capture integrity. Local fixtures only; production requires signed,
# attested captures.
VERILY_STATIC_QR_ENABLED=false
VERILY_DEVICE_INTEGRITY_MODE=disabled
VERILY_CAPTURE_SIGNATURE_MODE=optional
VERILY_PLAY_INTEGRITY_SERVICE_ACCOUNT_JSON=
# SHA-256 of the app's signing certificate, hex, comma-separated during a
# rotation. Key attestation and Play Integrity both require it to match.
VERILY_ANDROID_SIGNING_CERT_SHA256=
# iPhone App Attest: the ten-character Apple team id (unset turns App Attest
# off), the bundle id (default fun.verily.app), and Apple's environment.
# Debug builds use the sandbox, which only a development server accepts.
VERILY_APPLE_TEAM_ID=
VERILY_IOS_BUNDLE_ID=
VERILY_APP_ATTEST_ENVIRONMENT=production

# Proof verification. manual-review needs no secret; openrouter needs the
# backend-only key plus the attested deployment settings in
# docs/openrouter-verification.md.
VERILY_MEDIA_VERIFIER_MODE=manual-review
VERILY_MEDIA_VERIFIER_URL=
VERILY_MEDIA_VERIFIER_TOKEN=
VERILY_OPENROUTER_API_KEY=

# Abuse correlation.
VERILY_ABUSE_RUNTIME_MODE=
VERILY_ABUSE_PSEUDONYM_SECRET=
VERILY_ABUSE_PSEUDONYM_KEY_EPOCH=

# Reward escrow: disabled, local-development (a labelled simulation that moves
# no money, development and test only), or solana (the real escrow program;
# see docs/reward-escrow.md#server-gateway). The review threshold is in token
# atoms.
VERILY_REWARD_ESCROW_MODE=disabled
VERILY_REWARD_REVIEW_THRESHOLD_ATOMS=

# Solana reward gateway (VERILY_REWARD_ESCROW_MODE=solana). Development uses
# devnet with local keypairs (Solana CLI JSON arrays); staging and production
# require Cloud KMS. The RPC URL may embed a provider key, so it is a secret.
# Leave the KMS lines commented unless the signer is kms: exactly one
# credential source may be set.
VERILY_REWARD_CLUSTER=devnet
VERILY_REWARD_SOLANA_RPC_URL=
VERILY_REWARD_SIGNER=local-keypair
VERILY_REWARD_ARBITER_ADDRESS=
VERILY_REWARD_FEE_PAYER_ADDRESS=
VERILY_REWARD_ARBITER_KEYPAIR=
VERILY_REWARD_FEE_PAYER_KEYPAIR=
# VERILY_REWARD_KMS_ARBITER_KEY=projects/.../cryptoKeyVersions/1
# VERILY_REWARD_KMS_FEE_PAYER_KEY=projects/.../cryptoKeyVersions/1
# VERILY_REWARD_KMS_CREDENTIALS_FILE=
# VERILY_REWARD_KMS_CREDENTIALS_JSON=
# Local validators only (development and test): its genesis hash and, when
# deployed elsewhere, the program id.
# VERILY_REWARD_SOLANA_GENESIS_HASH=
# VERILY_REWARD_ESCROW_PROGRAM_ID=
# Mainnet stays refused unless this is exactly true in production, after the
# escrow and its custody pass review. It has not been reviewed for real money.
# VERILY_REWARD_MAINNET_ENABLED=false

# App platform signing keys (generated locally by Monosecret when absent).
# Every App's whsec_ webhook secret is derived from the master key; receipts
# are signed with the Ed25519 seed and published in /.well-known/jwks.json.
VERILY_WEBHOOK_SIGNING_MASTER_KEY=
VERILY_RECEIPT_SIGNING_KEY=
VERILY_RECEIPT_RETIRED_PUBLIC_KEYS=

# Optional Apple DeviceCheck service key. Provision the .p8 value through
# Monosecret's ignored dotenv provider; never commit it or resolve per request.
# Without credentials Apple risk checks hold proofs for manual review.
VERILY_DEVICE_CHECK_KEY_ID=
VERILY_DEVICE_CHECK_PRIVATE_KEY=
