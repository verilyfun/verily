{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "incremental": true,
  "json": {
    "indentWidth": 2,
    "useTabs": false
  },
  "markdown": {},
  "toml": {},
  "yaml": {
    "indentWidth": 2
  },
  "excludes": [
    "**/.devenv*/**",
    "**/.direnv/**",
    "**/.git/**",
    "**/.leptoskit/**",
    "**/.vscode/**",
    "**/target/**",
    "**/dist/**",
    "**/build/**",
    "**/Pods/**",
    "**/migrations/**",
    "**/migrations-postgres/**",
    "**/ios/**/*.pbxproj",
    "**/ios/**/*.plist",
    "**/ios/**/*.storyboard",
    "**/ios/**/*.xib",
    "**/ios/**/*.xcscheme",
    "**/ios/**/*.xcworkspacedata",
    "**/*.xcassets/**",
    "**/android/.gradle/**",
    "**/android/captures/**",
    "**/android/**/*.xml",
    "**/android/**/*.properties",
    "**/key_attestation/vectors/*.json",
    "**/app_attest/vectors/*.json"
  ],
  "plugins": [
    "https://plugins.dprint.dev/json-0.21.1.wasm",
    "https://plugins.dprint.dev/markdown-0.21.1.wasm",
    "https://plugins.dprint.dev/toml-0.7.0.wasm",
    "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm"
  ]
}
